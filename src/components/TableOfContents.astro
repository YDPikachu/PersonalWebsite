---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
	/** "sidebar" stays visible beside the post; "inline" is a collapsible box for small screens. */
	variant: 'sidebar' | 'inline';
}

const { headings, variant } = Astro.props;

// Group h3s under their h2 so the list can be nested.
type Item = MarkdownHeading & { children: MarkdownHeading[] };
const items: Item[] = [];
for (const h of headings) {
	if (h.depth === 2) items.push({ ...h, children: [] });
	else if (h.depth === 3 && items.length) items[items.length - 1].children.push(h);
}
---

{
	items.length > 0 && (
		<nav class:list={['toc', `toc--${variant}`]} aria-label="Table of contents">
			{variant === 'inline' ? (
				<details>
					<summary>On this page</summary>
					<ol>
						{items.map((item) => (
							<li>
								<a href={`#${item.slug}`} data-toc-link={item.slug}>{item.text}</a>
							</li>
						))}
					</ol>
				</details>
			) : (
				<>
					<p class="toc-title">On this page</p>
					<ol>
						{items.map((item) => (
							<li>
								<a href={`#${item.slug}`} data-toc-link={item.slug}>{item.text}</a>
								{item.children.length > 0 && (
									<ol>
										{item.children.map((child) => (
											<li>
												<a href={`#${child.slug}`} data-toc-link={child.slug}>{child.text}</a>
											</li>
										))}
									</ol>
								)}
							</li>
						))}
					</ol>
				</>
			)}
		</nav>
	)
}

<style>
	.toc {
		font-size: 0.8em;
		line-height: 1.4;
	}
	.toc ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.toc li {
		margin: 0;
	}
	.toc a {
		display: block;
		padding: 0.3em 0 0.3em 0.9em;
		border-left: 2px solid rgb(var(--gray-light));
		color: rgb(var(--gray));
		text-decoration: none;
		transition: color 0.15s, border-color 0.15s;
	}
	.toc a:hover {
		color: rgb(var(--black));
	}
	.toc a.is-active {
		color: var(--accent);
		border-left-color: var(--accent);
		font-weight: 700;
	}
	.toc ol ol a {
		padding-left: 1.8em;
		font-size: 0.92em;
	}

	/* Sidebar: stays in view while scrolling, scrolls on its own if long */
	.toc--sidebar {
		position: sticky;
		top: 2em;
		max-height: calc(100vh - 4em);
		overflow-y: auto;
	}
	.toc-title {
		margin: 0 0 0.6em;
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}

	/* Inline: collapsible box at the top of the post */
	.toc--inline details {
		margin-bottom: 2em;
		padding: 0.8em 1.1em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		background: rgba(var(--gray-light), 35%);
	}
	.toc--inline summary {
		cursor: pointer;
		font-weight: 700;
		color: rgb(var(--black));
	}
	.toc--inline ol {
		margin-top: 0.6em;
	}
</style>

<script>
	// Highlight the link for whichever section is currently being read.
	function setupTocHighlight() {
		const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
		if (!links.length) return;

		const slugs = [...new Set([...links].map((a) => a.dataset.tocLink!))];
		const headings = slugs
			.map((slug) => document.getElementById(slug))
			.filter((el): el is HTMLElement => el !== null);

		const setActive = (slug: string) => {
			links.forEach((a) => a.classList.toggle('is-active', a.dataset.tocLink === slug));
		};

		const update = () => {
			// The active heading is the last one that has scrolled past the top third of the screen.
			const line = window.innerHeight / 3;
			let current = headings[0];
			for (const h of headings) {
				if (h.getBoundingClientRect().top <= line) current = h;
				else break;
			}
			if (current) setActive(current.id);
		};

		let ticking = false;
		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					update();
					ticking = false;
				});
			},
			{ passive: true },
		);
		update();
	}

	setupTocHighlight();
</script>
